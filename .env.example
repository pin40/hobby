TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
FIREBASE_CREDENTIALS_PATH=path/to/your/firebase-credentials.json
# Alternatively, you can use individual Firebase config variables:
# FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
# FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
# FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
# FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
# FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
# FIREBASE_DATABASE_URL=YOUR_FIREBASE_DATABASE_URL

GOOGLE_CREDENTIALS_PATH=path/to/your/google-credentials.json

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_BASE_URL=https://api.example.com/gemini # Optional: Or OpenRouter, etc.
GEMINI_MODEL=gemini-pro # Optional: Specify the model

FLASK_SECRET_KEY=YOUR_FLASK_SECRET_KEY
FLASK_DEBUG=True
